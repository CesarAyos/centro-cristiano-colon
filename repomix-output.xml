<script>
  import { onMount } from 'svelte';

  let scrolled = false;
  let mobileOpen = false;
  let churchOpen = false;

  function onScroll() {
    scrolled = window.scrollY > 40;
  }

  onMount(() => {
    window.addEventListener('scroll', onScroll, { passive: true });
    return () => window.removeEventListener('scroll', onScroll);
  });

  function closeMenu() {
    mobileOpen = false;
    churchOpen = false;
  }
</script>


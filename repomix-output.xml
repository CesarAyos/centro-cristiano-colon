<file path="src/lib/public.css">
/* ============================================================
   CENTRO CRISTIANO MISIÓN GLOBAL COLÓN — SISTEMA DE DISEÑO PÚBLICO
   Misma paleta (#92ae83 · #c8a97e · #0e0d06) con nueva tipografía
   ============================================================ */

.public-site {
  --cc-primary: #92ae83;
  --cc-primary-dark: #789768;
  --cc-primary-deep: #5f7d52;
  --cc-accent: #c8a97e;
  --cc-accent-soft: #e6d5b4;
  --cc-dark: #14120e;
  --cc-darker: #0e0d06;
  --cc-card: #1d1a15;
  --cc-cream: #f5f1e8;
  --cc-muted: #b7b0a3;
  --cc-border: rgba(200, 169, 126, 0.16);
  --cc-gold-line: rgba(200, 169, 126, 0.35);
  --cc-shadow: 0 24px 70px rgba(0, 0, 0, 0.5);
  --cc-radius: 20px;
  --cc-gradient: linear-gradient(135deg, #92ae83 0%, #789768 45%, #5f7d52 100%);
  --cc-gradient-gold: linear-gradient(135deg, #e6d5b4 0%, #c8a97e 100%);

  background-color: var(--cc-dark);
  color: var(--cc-cream);
  font-family: 'Jost', sans-serif;
  font-weight: 300;
  line-height: 1.75;
  overflow-x: hidden;
  min-height: 100vh;
}

.public-site h1,
.public-site h2,
.public-site h3,
.public-site h4,
.public-site h5 {
  font-family: 'Cormorant Garamond', serif;
  font-weight: 600;
  color: var(--cc-cream);
  letter-spacing: 0.4px;
}

/* ---------- Contenedor ---------- */
.cc-container {
  width: 100%;
  max-width: 1240px;
  margin: 0 auto;
  padding: 0 24px;
}

.cc-section {
  padding: 110px 0;
  position: relative;
}

/* ---------- Encabezado de sección ---------- */
.cc-overline {
  display: inline-flex;
  align-items: center;
  gap: 14px;
  font-family: 'Jost', sans-serif;
  font-weight: 600;
  font-size: 0.8rem;
  letter-spacing: 4px;
  text-transform: uppercase;
  color: var(--cc-accent);
  margin-bottom: 18px;
}

.cc-overline::before,
.cc-overline::after {
  content: '';
  height: 1px;
  width: 42px;
  background: var(--cc-gold-line);
}

.cc-section-title {
  font-size: clamp(2.4rem, 4.5vw, 3.6rem);
  line-height: 1.12;
  margin-bottom: 18px;
}

.cc-section-sub {
  color: var(--cc-muted);
  font-size: 1.08rem;
  max-width: 640px;
  margin: 0 auto;
}

/* ---------- Botones ---------- */
.cc-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  background: var(--cc-gradient);
  color: #fff;
  font-weight: 600;
  font-family: 'Jost', sans-serif;
  font-size: 0.95rem;
  letter-spacing: 0.5px;
  padding: 0.95rem 2.2rem;
  border-radius: 999px;
  text-decoration: none;
  border: none;
  cursor: pointer;
  box-shadow: 0 10px 30px rgba(120, 151, 104, 0.35);
  transition: transform 0.3s ease, box-shadow 0.3s ease, background 0.3s ease;
  position: relative;
  overflow: hidden;
}

.cc-btn::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(120deg, transparent 30%, rgba(255, 255, 255, 0.25) 50%, transparent 70%);
  transform: translateX(-120%);
  transition: transform 0.6s ease;
}

.cc-btn:hover {
  transform: translateY(-3px);
  box-shadow: 0 16px 40px rgba(120, 151, 104, 0.5);
  color: #fff;
  text-decoration: none;
}

.cc-btn:hover::after {
  transform: translateX(120%);
}

.cc-btn--ghost {
  background: transparent;
  color: var(--cc-cream);
  border: 1px solid var(--cc-border);
  box-shadow: none;
}

.cc-btn--ghost:hover {
  border-color: var(--cc-accent);
  color: var(--cc-accent);
}

.cc-btn--gold {
  background: var(--cc-gradient-gold);
  color: #2a2115;
  box-shadow: 0 10px 30px rgba(200, 169, 126, 0.3);
}

.cc-btn--gold:hover {
  color: #1d170d;
}

/* ---------- Banner de subpáginas ---------- */
.cc-banner {
  padding: 110px 0 90px;
  background: radial-gradient(ellipse at 70% 10%, rgba(146, 174, 131, 0.14), transparent 55%),
    radial-gradient(ellipse at 20% 90%, rgba(200, 169, 126, 0.12), transparent 50%),
    linear-gradient(160deg, #0e0d06 0%, #17150f 100%);
  text-align: center;
  position: relative;
  overflow: hidden;
}

.cc-banner::before {
  content: '';
  position: absolute;
  inset: 0;
  background: url('/logo.png') no-repeat center;
  background-size: 520px;
  opacity: 0.05;
}

.cc-banner h1 {
  font-size: clamp(2.8rem, 6vw, 4.6rem);
  margin-bottom: 16px;
}

.cc-banner p {
  color: var(--cc-muted);
  max-width: 560px;
  margin: 0 auto;
  font-size: 1.12rem;
}

/* ---------- Tarjetas ---------- */
.cc-card {
  background: linear-gradient(160deg, var(--cc-card) 0%, #17140f 100%);
  border: 1px solid var(--cc-border);
  border-radius: var(--cc-radius);
  padding: 2.2rem;
  height: 100%;
  position: relative;
  overflow: hidden;
  transition: transform 0.4s ease, border-color 0.4s ease, box-shadow 0.4s ease;
}

.cc-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3px;
  background: var(--cc-gradient);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.45s ease;
}

.cc-card:hover {
  transform: translateY(-8px);
  border-color: rgba(200, 169, 126, 0.4);
  box-shadow: var(--cc-shadow);
}

.cc-card:hover::before {
  transform: scaleX(1);
}

.cc-card-icon {
  width: 58px;
  height: 58px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 14px;
  background: rgba(146, 174, 131, 0.12);
  border: 1px solid var(--cc-border);
  color: var(--cc-accent);
  font-size: 1.35rem;
  margin-bottom: 1.4rem;
}

.cc-card h3 {
  font-size: 1.55rem;
  margin-bottom: 0.9rem;
}

.cc-card p {
  color: var(--cc-muted);
  font-size: 0.98rem;
  margin-bottom: 0;
}

/* ---------- Cita bíblica ---------- */
.cc-verse {
  background: linear-gradient(135deg, #0e0d06 0%, #1a1711 100%);
  border-top: 1px solid var(--cc-border);
  border-bottom: 1px solid var(--cc-border);
  padding: 90px 0;
  text-align: center;
  position: relative;
  overflow: hidden;
}

.cc-verse::before {
  content: '\201C';
  position: absolute;
  top: -60px;
  left: 50%;
  transform: translateX(-50%);
  font-family: 'Cormorant Garamond', serif;
  font-size: 300px;
  color: rgba(200, 169, 126, 0.1);
  line-height: 1;
}

.cc-verse blockquote {
  font-family: 'Cormorant Garamond', serif;
  font-style: italic;
  font-weight: 500;
  font-size: clamp(1.6rem, 3.4vw, 2.4rem);
  color: var(--cc-accent-soft);
  max-width: 820px;
  margin: 0 auto;
  line-height: 1.45;
}

.cc-verse cite {
  display: block;
  margin-top: 22px;
  font-family: 'Jost', sans-serif;
  font-style: normal;
  font-weight: 600;
  letter-spacing: 3px;
  text-transform: uppercase;
  font-size: 0.85rem;
  color: var(--cc-primary);
}

/* ---------- Animación de aparición ---------- */
.cc-reveal {
  opacity: 0;
  transform: translateY(28px);
  transition: opacity 0.9s cubic-bezier(0.22, 1, 0.36, 1),
    transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
  will-change: opacity, transform;
}

.cc-reveal.cc-visible {
  opacity: 1;
  transform: translateY(0);
}

.cc-d1 { transition-delay: 0.12s; }
.cc-d2 { transition-delay: 0.24s; }
.cc-d3 { transition-delay: 0.36s; }
.cc-d4 { transition-delay: 0.48s; }

/* ---------- Responsive ---------- */
@media (max-width: 768px) {
  .cc-section {
    padding: 72px 0;
  }

  .cc-banner {
    padding: 88px 0 64px;
  }

  .cc-card {
    padding: 1.6rem;
  }
}
</file>

